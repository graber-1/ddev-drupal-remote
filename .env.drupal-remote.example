#ddev-generated
# drupal-remote settings for this project; see the add-on's README for all keys.

# SSH access shared by all environments.
REMOTE_SSH_HOST="203.0.113.10"
REMOTE_SSH_USER="deploy"
REMOTE_SSH_PORT="22"

# Remote environments, the first one is the default.
